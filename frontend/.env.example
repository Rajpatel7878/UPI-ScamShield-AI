# Frontend environment variables for UPI ScamShield AI
# See the backend .env.example for API keys and server config.

# Local development: the FastAPI server on port 8000.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Production (set in the Vercel project's Environment Variables):
# VITE_API_BASE_URL=https://your-backend-host.example.com/api/v1
#
# Only VITE_-prefixed values are bundled into the browser build. Never put
# GEMINI_API_KEY, JWT_SECRET_KEY or DATABASE_URL in this file.