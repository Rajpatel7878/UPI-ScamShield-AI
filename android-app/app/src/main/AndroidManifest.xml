<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Backend analysis and warning notifications. Notification access itself is
         granted by the user in system settings and is not a manifest permission. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Notification access is granted by the user in Android Settings → Apps →
         ScamShield AI → Notification access. BIND_NOTIFICATION_LISTENER_SERVICE is a
         signature-level permission held by the system: it is applied to the service
         below via android:permission and must never be requested with
         <uses-permission>, which would be ignored and is flagged by lint. -->

    <application
        android:name=".ScamShieldApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ScamShield">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.ScamShield"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- NotificationListenerService for monitoring UPI/payment notifications.
             The service is protected by BIND_NOTIFICATION_LISTENER_SERVICE permission.
             Do NOT request SMS, contacts, call logs, or accessibility permissions. -->
        <service
            android:name=".security.ScamNotificationListenerService"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

    </application>

</manifest>
