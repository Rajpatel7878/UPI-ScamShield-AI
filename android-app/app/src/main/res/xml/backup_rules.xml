<?xml version="1.0" encoding="utf-8"?>
<!--
  Pre-Android 12 counterpart to data_extraction_rules.xml. Nothing is backed
  up, consistent with android:allowBackup="false".
-->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="file" />
    <exclude domain="external" />
</full-backup-content>
