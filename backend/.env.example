# UPI ScamShield AI - backend environment variables
# Copy to .env and fill in values. Never commit a real .env file.

# Application
APP_NAME=UPI ScamShield AI
APP_VERSION=1.0.0
ENVIRONMENT=development
# Set DEBUG=false in production. ENVIRONMENT=production also enables HSTS and
# requires a strong JWT_SECRET_KEY at startup.
DEBUG=true
# Interactive API docs at /docs and /redoc. Set false to hide them publicly.
ENABLE_DOCS=true
# text (default) or json. JSON is recommended on hosting platforms.
LOG_FORMAT=text
LOG_LEVEL=INFO

# Database. SQLite is fine for local development. Use the managed PostgreSQL
# connection string in production, e.g.
# DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# The application normalises postgres:// and postgresql:// to the psycopg driver.
DATABASE_URL=sqlite:///./scamshield.db

# API and CORS
API_PREFIX=/api/v1
FRONTEND_URL=http://localhost:5173
# Optional additional origins, comma-separated:
# CORS_ORIGINS=https://app.example.com,https://staging.example.com

# Authentication
# REQUIRED in production: at least 32 random characters.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Android device credentials (see docs/ANDROID_DEVICE_AUTH.md).
# Device tokens are random values issued per installation; only their SHA-256
# hash is stored. They are separate from JWT_SECRET_KEY - never reuse that value
# as a device token, and do not ship a shared device key in the Android app.
DEVICE_TOKEN_EXPIRE_DAYS=90
MAX_ACTIVE_DEVICES_PER_USER=5

# Abuse protection (requests per window, in-memory per process)
RATE_LIMIT_LOGIN_PER_MINUTE=10
RATE_LIMIT_REGISTER_PER_5_MINUTES=5
RATE_LIMIT_ANALYZE_PER_MINUTE=30
RATE_LIMIT_API_PER_MINUTE=300
# Only enable behind a trusted reverse proxy that sets X-Forwarded-For
TRUST_PROXY_HEADERS=false
MAX_REQUEST_BYTES=1048576

# AI providers (all optional). Leave both keys empty to run rule-based + URL
# analysis only; no external request is made in that case.
# Provider order: OpenRouter first, then Gemini as fallback. Keys are read only
# by the backend and are never sent to the browser.

# OpenRouter (primary provider when configured)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=google/gemini-3.5-flash
OPENROUTER_TIMEOUT_SECONDS=30
OPENROUTER_MAX_RETRIES=2

# Google Gemini (fallback provider)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=30
GEMINI_MAX_RETRIES=2
